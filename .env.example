# Copy to .env (git-ignored) and fill in. Leave VOCAB_LLM_PROVIDER empty to run without AI.

# Claude via the Anthropic SDK (pip install ".[anthropic]")
# VOCAB_LLM_PROVIDER=anthropic
# VOCAB_LLM_MODEL=<a Claude model id>
# ANTHROPIC_API_KEY=...

# Or any OpenAI-compatible API (OpenAI, DeepSeek, Qwen, OpenRouter, ...)
# VOCAB_LLM_PROVIDER=openai
# VOCAB_LLM_MODEL=<model id>
# VOCAB_LLM_API_KEY=...
# VOCAB_LLM_BASE_URL=https://api.openai.com/v1
